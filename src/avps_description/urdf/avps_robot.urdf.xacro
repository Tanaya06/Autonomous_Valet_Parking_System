<?xml version="1.0"?>
<robot name="avps_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════
       PROPERTIES
       Define all dimensions in one place — easy to tune later
  ════════════════════════════════════════════════════════════════ -->
  <xacro:property name="base_length"   value="0.5"/>
  <xacro:property name="base_width"    value="0.3"/>
  <xacro:property name="base_height"   value="0.15"/>
  <xacro:property name="wheel_radius"  value="0.08"/>
  <xacro:property name="wheel_width"   value="0.04"/>
  <xacro:property name="wheel_sep"     value="0.34"/>
  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="lidar_radius"  value="0.04"/>
  <xacro:property name="lidar_height"  value="0.04"/>

  <!-- ═══════════════════════════════════════════════════════════
       MATERIALS
  ════════════════════════════════════════════════════════════════ -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.4 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <!-- ═══════════════════════════════════════════════════════════
       BASE LINK
       The main body of the robot. All other links attach here.
  ════════════════════════════════════════════════════════════════ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia
        ixx="0.0833"  ixy="0.0" ixz="0.0"
        iyy="0.2083"  iyz="0.0"
        izz="0.2500"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════════════════
       WHEEL MACRO
       Reusable macro for left and right wheels
  ════════════════════════════════════════════════════════════════ -->
  <xacro:macro name="wheel" params="name y_reflect">
    <link name="${name}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia
          ixx="0.0013" ixy="0.0" ixz="0.0"
          iyy="0.0013" iyz="0.0"
          izz="0.0016"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel_link"/>
      <origin
        xyz="0.0 ${y_reflect * wheel_sep / 2.0} ${-base_height / 2.0}"
        rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left"  y_reflect=" 1"/>
  <xacro:wheel name="right" y_reflect="-1"/>

  <!-- ═══════════════════════════════════════════════════════════
       CASTER WHEEL
       Passive wheel at the front for balance
  ════════════════════════════════════════════════════════════════ -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin
      xyz="${base_length/2 - caster_radius}
           0
           ${-base_height/2 - caster_radius + wheel_radius}"
      rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       2D LIDAR
       Primary sensor for SLAM and obstacle detection.
  ════════════════════════════════════════════════════════════════ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin
      xyz="0.0 0.0 ${base_height/2 + lidar_height/2}"
      rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════
       GAZEBO HARMONIC PLUGINS
       Gazebo Harmonic uses a different plugin API from Classic.
       Plugins reference gz::sim::systems::* instead of
       libgazebo_ros_*.so. Topics are bridged to ROS 2 via
       ros_gz_bridge (see gazebo.launch.py).
  ════════════════════════════════════════════════════════════════ -->

  <!-- Differential Drive Plugin (Gazebo Harmonic native)
       Subscribes to Gz topic: /cmd_vel
       Publishes Gz topics:    /odom, /tf
       Bridged to ROS 2 by the ros_gz_bridge node in the launch file -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher Plugin (Gz Harmonic native)
       Publishes wheel joint positions for robot_state_publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- 2D LiDAR Sensor (Gazebo Harmonic native)
       Publishes Gz topic: /scan (LaserScan)
       Bridged to ROS 2 /scan by ros_gz_bridge -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="lidar">
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Base link material for Gazebo -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.1 0.4 0.8 1</ambient>
      <diffuse>0.1 0.4 0.8 1</diffuse>
    </material>
  </gazebo>

</robot>