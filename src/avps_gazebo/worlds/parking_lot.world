<?xml version="1.0"?>
<sdf version="1.9">
  <world name="parking_lot">

    <!-- ── Gz Harmonic Required System Plugins ──────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensors system enables lidar, camera, etc. simulation -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>

    <!-- ── Physics ─────────────────────────────────────────────── -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Lighting (explicit — not model://sun) ────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground Plane (explicit — not model://ground_plane) ───── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════
         PARKING LOT BOUNDARY WALLS
         A 20m x 15m enclosed parking area
    ═══════════════════════════════════════════════════════════════ -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 7.5 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -7.5 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════
         PARKING SLOT DIVIDERS
         Row A — North side (5 slots, each 2m wide)
    ═══════════════════════════════════════════════════════════════ -->

    <model name="divider_a0">
      <static>true</static>
      <pose>-4.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_a1">
      <static>true</static>
      <pose>-2.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_a2">
      <static>true</static>
      <pose>0.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_a3">
      <static>true</static>
      <pose>2.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_a4">
      <static>true</static>
      <pose>4.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════
         ROW B — South side (5 slots)
    ═══════════════════════════════════════════════════════════════ -->

    <model name="divider_b0">
      <static>true</static>
      <pose>-4.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_b1">
      <static>true</static>
      <pose>-2.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_b2">
      <static>true</static>
      <pose>0.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_b3">
      <static>true</static>
      <pose>2.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="divider_b4">
      <static>true</static>
      <pose>4.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient><diffuse>0.8 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════
         OBSTACLE — A parked car (static box) in slot A2
         Forces the planner to navigate around it
    ═══════════════════════════════════════════════════════════════ -->
    <model name="parked_car_a2">
      <static>true</static>
      <pose>-1.0 6.2 0.2  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.8 0.9 0.4</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.8 0.9 0.4</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>