<?xml version="1.0"?>
<sdf version="1.6">
  <world name="parking_lot">

    <!-- ── Physics ─────────────────────────────────────────────── -->
    <physics type="ode">
      <real_time_update_rate>100</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- ── Lighting ────────────────────────────────────────────── -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ── Ground Plane ────────────────────────────────────────── -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ══════════════════════════════════════════════════════════
         PARKING LOT BOUNDARY WALLS
         A 20m x 15m enclosed parking area
    ═══════════════════════════════════════════════════════════════ -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 7.5 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -7.5 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>20 0.2 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 15 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════
         PARKING SLOT DIVIDERS
         Row A — North side (5 slots, each 2m wide)
         These thin pillars mark individual parking spaces
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Row A dividers (y = 4.0 to 7.0, north side) -->
    <model name="divider_a0">
      <static>true</static>
      <pose>-4.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_a1">
      <static>true</static>
      <pose>-2.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_a2">
      <static>true</static>
      <pose>0.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_a3">
      <static>true</static>
      <pose>2.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_a4">
      <static>true</static>
      <pose>4.0 5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════
         ROW B — South side (5 slots)
    ═══════════════════════════════════════════════════════════════ -->
    <model name="divider_b0">
      <static>true</static>
      <pose>-4.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_b1">
      <static>true</static>
      <pose>-2.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_b2">
      <static>true</static>
      <pose>0.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_b3">
      <static>true</static>
      <pose>2.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="divider_b4">
      <static>true</static>
      <pose>4.0 -5.5 0.3  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 0.6</size></box></geometry>
          <material><ambient>0.8 0.8 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════
         OBSTACLE — A parked car (static box) in slot A2
         This forces the planner to navigate around it
    ═══════════════════════════════════════════════════════════════ -->
    <model name="parked_car_a2">
      <static>true</static>
      <pose>-1.0 6.2 0.2  0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.8 0.9 0.4</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.8 0.9 0.4</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
